# Public URL of the deployed site — used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Force-show "// TODO" content placeholders in production builds (they always show in `next dev`).
# NEXT_PUBLIC_SHOW_PLACEHOLDERS=true

# ── Contact form ────────────────────────────────────────────────────────────
# Leave CONTACT_PROVIDER empty and the site shows a graceful "email me directly" fallback.
# Options: resend | webhook
CONTACT_PROVIDER=

# Where messages are delivered (used by the resend provider; forwarded to webhooks).
CONTACT_EMAIL=

# provider = resend  (https://resend.com — the sender domain must be verified there)
RESEND_API_KEY=
CONTACT_FROM_EMAIL="Portfolio <portfolio@your-domain.com>"

# provider = webhook  (n8n, Make, Zapier, Slack workflow, your own endpoint…)
# Receives a JSON POST: { name, email, message, to, submittedAt }
CONTACT_WEBHOOK_URL=
# Optional — sent as the "X-Webhook-Secret" header.
CONTACT_WEBHOOK_SECRET=
